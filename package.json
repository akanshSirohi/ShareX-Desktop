{
  "name": "sharex-desktop",
  "private": true,
  "version": "0.1.3",
  "description": "Local file sharing between your desktop, phone, and browser",
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "https://github.com/akanshSirohi/ShareX-Desktop.git" },
  "homepage": "https://github.com/akanshSirohi/ShareX-Desktop#readme",
  "bugs": { "url": "https://github.com/akanshSirohi/ShareX-Desktop/issues" },
  "engines": { "node": ">=24" },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "build:portal": "npm --prefix portal-source run build && node scripts/sync-portal.mjs",
    "test:portal": "npm --prefix portal-source test",
    "test:connection": "node --test tests/connection.test.ts",
    "test:release": "node --test tests/release.test.cjs",
    "test": "npm run test:connection && npm run test:release && cargo test --manifest-path src-tauri/Cargo.toml --lib -- --test-threads=1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.577.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
